# плохая практика 1: использовать тег лейтест, во первых это плохо из за того, что версия может поменяться и докерфайл перестанет работать, а также использование тяжелых образов нагружает докерфайл
FROM ubuntu:latest

# плохая праткика 2: многократное использование ран, хотя можно все за один выполнить, это создает лишние слои и нагружает докерфайл
RUN apt-get update
RUN apt-get install -y python3

COPY app.py /app.py

# плохая практика 3: запуск команд от обычного рут пользователя, это вредно для безопасности контейнера
CMD ["python3", "/app.py"]
